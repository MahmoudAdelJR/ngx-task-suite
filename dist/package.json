{
  "name": "ngx-task",
  "version": "0.1.0",
  "description": "Signal-first controlled asynchronous actions for Angular with cancellation, lifecycle cleanup, and explicit concurrency policies.",
  "keywords": [
    "angular",
    "signals",
    "async",
    "task",
    "concurrency",
    "cancellation",
    "rxjs",
    "zoneless",
    "promise",
    "observable"
  ],
  "author": "Mahmoud Adel <mahmoudadeljr14@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MahmoudAdelJR/ngx-task-suite.git"
  },
  "homepage": "https://MahmoudAdelJR.github.io/ngx-task-suite/",
  "bugs": {
    "url": "https://github.com/MahmoudAdelJR/ngx-task-suite/issues"
  },
  "sideEffects": false,
  "main": "./public-api.js",
  "types": "./public-api.d.ts",
  "exports": {
    ".": {
      "types": "./public-api.d.ts",
      "default": "./public-api.js"
    },
    "./directives": {
      "types": "./lib/directives/public-api.d.ts",
      "default": "./lib/directives/public-api.js"
    },
    "./testing": {
      "types": "./lib/testing/public-api.d.ts",
      "default": "./lib/testing/public-api.js"
    }
  },
  "peerDependencies": {
    "@angular/core": ">=16.0.0",
    "rxjs": ">=7.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
